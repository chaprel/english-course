  "a0301": {
   "audio": {
    "am_michael": {
     "n": "audio/0622d1c761d72b28.mp3"
    }
   },
   "en": "Hey! How was your weekend?",
   "lesson": "0003",
   "srs": false
  },
  "a0302": {
   "audio": {
    "af_bella": {
     "n": "audio/672a432b6482a84c.mp3"
    }
   },
   "en": "Pretty good, thanks. We had a match on Saturday.",
   "lesson": "0003",
   "srs": false
  },
  "a0303": {
   "audio": {
    "am_michael": {
     "n": "audio/787fe0688f768dab.mp3"
    }
   },
   "en": "Oh, nice. How did it go?",
   "lesson": "0003",
   "srs": false
  },
  "a0304": {
   "audio": {
    "af_bella": {
     "n": "audio/9de56cfccf0cc044.mp3"
    }
   },
